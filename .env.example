# Secret key cho kênh xác thực Out-of-Band (PyOTP RFC 6238)
VISHING_OTP_SECRET=JBSWY3DPEHPK3PXP
# Ngưỡng điểm nghi ngờ giả mạo (0.0 -> 1.0)
FAKE_SCORE_THRESHOLD=0.50
# Thời gian hiệu lực của mã OTP (giây)
OTP_TTL_SECONDS=60
# Số lần nhập sai OTP tối đa trước khi khóa (Chống Brute-Force TC6)
OTP_MAX_ATTEMPTS=3
